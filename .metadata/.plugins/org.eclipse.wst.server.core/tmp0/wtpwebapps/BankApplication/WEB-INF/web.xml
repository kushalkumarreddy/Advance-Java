<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- ============================= -->
    <!-- Application-wide Information -->
    <!-- ============================= -->

    <context-param>
        <param-name>bankName</param-name>
        <param-value>ABC Bank</param-value>
    </context-param>

    <context-param>
        <param-name>bankAddress</param-name>
        <param-value>Bangalore</param-value>
    </context-param>


    <!-- ============================= -->
    <!-- Login Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.bank.LoginServlet</servlet-class>

        <!-- LoginServlet-specific information -->
        <init-param>
            <param-name>adminEmail</param-name>
            <param-value>admin@abcbank.com</param-value>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Dashboard Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.bank.DashboardServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Logout Servlet -->
    <!-- ============================= -->

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.bank.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>


    <!-- ============================= -->
    <!-- Welcome Page -->
    <!-- ============================= -->

    <welcome-file-list>
        <welcome-file>login.html</welcome-file>
    </welcome-file-list>

</web-app>